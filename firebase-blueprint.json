{
  "entities": {
    "ResearchEntry": {
      "title": "ResearchEntry",
      "description": "A school-based research study or TUKLAS project entry at Barobo National High School.",
      "type": "object",
      "properties": {
        "portalId": {
          "type": "string",
          "enum": ["bnhs"],
          "maxLength": 10,
          "description": "Institutional portal scope identifier for Barobo National High School."
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300,
          "description": "Full title of the research study or project."
        },
        "division": {
          "type": "string",
          "enum": ["basic", "action", "tuklas"],
          "maxLength": 20,
          "description": "Major research division: Basic Research, Action Research, or TUKLAS Fair."
        },
        "category": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Focus area, Action Research theme (1-7), or TUKLAS major category (1-4)."
        },
        "subcategory": {
          "type": "string",
          "maxLength": 120,
          "description": "Specific subcategory for TUKLAS or focus strand for Basic/Action research."
        },
        "abstract": {
          "type": "string",
          "minLength": 10,
          "maxLength": 4000,
          "description": "Structured research abstract or project summary."
        },
        "keywords": {
          "type": "string",
          "maxLength": 300,
          "description": "Comma-separated keywords for indexing and search."
        },
        "authors": {
          "type": "string",
          "minLength": 2,
          "maxLength": 300,
          "description": "Lead and co-author researcher names."
        },
        "authorRole": {
          "type": "string",
          "enum": ["Teacher", "Student", "Collaborative"],
          "maxLength": 30,
          "description": "Classification of proponent group."
        },
        "adviser": {
          "type": "string",
          "maxLength": 160,
          "description": "Research adviser, mentor, or consultant."
        },
        "departmentOrGrade": {
          "type": "string",
          "maxLength": 120,
          "description": "Subject department or student grade level and strand."
        },
        "schoolYear": {
          "type": "string",
          "maxLength": 20,
          "description": "Academic school year of the study (e.g., 2025-2026)."
        },
        "status": {
          "type": "string",
          "enum": ["Pending Review", "Ongoing", "Completed", "Approved", "Revision Requested", "Archived"],
          "maxLength": 30,
          "description": "Current workflow and publication status."
        },
        "methodology": {
          "type": "string",
          "maxLength": 1500,
          "description": "Research design, sampling, and data gathering procedure."
        },
        "keyFindings": {
          "type": "string",
          "maxLength": 2000,
          "description": "Key empirical findings, intervention results, or prototype performance."
        },
        "attachmentName": {
          "type": "string",
          "maxLength": 260,
          "description": "Recorded filename of uploaded PDF or Word manuscript."
        },
        "attachmentType": {
          "type": "string",
          "maxLength": 100,
          "description": "MIME type or document format label."
        },
        "attachmentSize": {
          "type": "number",
          "description": "File size in bytes."
        },
        "fileDocId": {
          "type": "string",
          "maxLength": 128,
          "description": "Document ID in research_files collection if uploaded."
        },
        "driveUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Google Drive document or folder URL."
        },
        "evaluationScore": {
          "type": "number",
          "description": "Committee evaluation score from 0 to 100."
        },
        "evaluationRemarks": {
          "type": "string",
          "maxLength": 1500,
          "description": "Official research committee evaluation remarks and recommendations."
        },
        "evaluatedBy": {
          "type": "string",
          "maxLength": 160,
          "description": "Name and title of the evaluating coordinator or panelist."
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the submitting researcher."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the record was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the record was last updated."
        }
      },
      "required": [
        "portalId",
        "title",
        "division",
        "category",
        "subcategory",
        "abstract",
        "keywords",
        "authors",
        "authorRole",
        "adviser",
        "departmentOrGrade",
        "schoolYear",
        "status",
        "methodology",
        "keyFindings",
        "attachmentName",
        "attachmentType",
        "attachmentSize",
        "fileDocId",
        "driveUrl",
        "evaluationScore",
        "evaluationRemarks",
        "evaluatedBy",
        "authorUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "ResearchFile": {
      "title": "ResearchFile",
      "description": "Uploaded PDF or Word manuscript file stored for cross-device download and preview.",
      "type": "object",
      "properties": {
        "portalId": {
          "type": "string",
          "enum": ["bnhs"],
          "maxLength": 10
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 260
        },
        "mimeType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "sizeBytes": {
          "type": "number"
        },
        "dataUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 750000
        },
        "uploaderUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "portalId",
        "fileName",
        "mimeType",
        "sizeBytes",
        "dataUrl",
        "uploaderUid",
        "createdAt"
      ]
    },
    "ResearcherProfile": {
      "title": "ResearcherProfile",
      "description": "Public institutional profile for a teacher or student researcher at Barobo National High School (PII-free).",
      "type": "object",
      "properties": {
        "portalId": {
          "type": "string",
          "enum": ["bnhs"],
          "maxLength": 10
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "enum": [
            "Student Researcher",
            "Teacher Researcher",
            "Master Teacher Researcher",
            "Teacher/Adviser",
            "Master Teacher / Adviser",
            "School Research Grammarian",
            "School Research Statistician",
            "Research Coordinator"
          ],
          "maxLength": 50
        },
        "departmentOrStrand": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "gradeOrPosition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "specialization": {
          "type": "string",
          "maxLength": 250
        },
        "bio": {
          "type": "string",
          "maxLength": 1000
        },
        "institutionIdCode": {
          "type": "string",
          "maxLength": 60
        },
        "driveFolderUrl": {
          "type": "string",
          "maxLength": 500
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 750000
        },
        "photoDriveUrl": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "portalId",
        "uid",
        "fullName",
        "role",
        "departmentOrStrand",
        "gradeOrPosition",
        "specialization",
        "bio",
        "institutionIdCode",
        "driveFolderUrl",
        "photoUrl",
        "photoDriveUrl",
        "createdAt",
        "updatedAt"
      ]
    },
    "ResearchComment": {
      "title": "ResearchComment",
      "description": "Peer review comment or inquiry posted on a BNHS research entry.",
      "type": "object",
      "properties": {
        "portalId": {
          "type": "string",
          "enum": ["bnhs"],
          "maxLength": 10
        },
        "researchId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "authorRole": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "content": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "portalId",
        "researchId",
        "authorUid",
        "authorName",
        "authorRole",
        "content",
        "createdAt"
      ]
    },
    "ResearchSubscription": {
      "title": "ResearchSubscription",
      "description": "User email notification subscription for status changes and new comments on a specific research entry (PII-isolated to owner and admin).",
      "type": "object",
      "properties": {
        "portalId": {
          "type": "string",
          "enum": ["bnhs"],
          "maxLength": 10
        },
        "researchId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "researchTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "subscriberUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "subscriberEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "notifyOnStatusChange": {
          "type": "boolean"
        },
        "notifyOnComments": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "portalId",
        "researchId",
        "researchTitle",
        "subscriberUid",
        "subscriberEmail",
        "notifyOnStatusChange",
        "notifyOnComments",
        "createdAt"
      ]
    },
    "OverviewItem": {
      "title": "OverviewItem",
      "description": "Customizable Overview Section banner or highlight card managed by BNHS Administrators with photo upload support.",
      "type": "object",
      "properties": {
        "portalId": {
          "type": "string",
          "enum": ["bnhs"],
          "maxLength": 10
        },
        "itemType": {
          "type": "string",
          "enum": ["hero", "card"],
          "maxLength": 20
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 300
        },
        "subtitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 5,
          "maxLength": 2000
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 750000
        },
        "divisionLink": {
          "type": "string",
          "enum": ["none", "basic", "action", "tuklas"],
          "maxLength": 20
        },
        "displayOrder": {
          "type": "number"
        },
        "isDeleted": {
          "type": "boolean"
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "portalId",
        "itemType",
        "code",
        "title",
        "subtitle",
        "description",
        "imageUrl",
        "divisionLink",
        "displayOrder",
        "isDeleted",
        "updatedByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator registry entry for BNHS Research Committee coordinators.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "appointedNote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "appointedNote", "createdAt"]
    },
    "StatusHistoryEntry": {
      "title": "StatusHistoryEntry",
      "description": "Chronological audit milestone of a research project's workflow status change at Barobo National High School.",
      "type": "object",
      "properties": {
        "portalId": {
          "type": "string",
          "enum": ["bnhs"],
          "maxLength": 10
        },
        "researchId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "previousStatus": {
          "type": "string",
          "maxLength": 50
        },
        "newStatus": {
          "type": "string",
          "enum": ["Pending Review", "Ongoing", "Completed", "Approved", "Revision Requested", "Archived"],
          "maxLength": 30
        },
        "evaluatorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "evaluatorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "evaluationScore": {
          "type": "number"
        },
        "remarks": {
          "type": "string",
          "maxLength": 1500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "portalId",
        "researchId",
        "previousStatus",
        "newStatus",
        "evaluatorName",
        "evaluatorUid",
        "evaluationScore",
        "remarks",
        "createdAt"
      ]
    },
    "ResearchGalleryItem": {
      "title": "ResearchGalleryItem",
      "description": "1000x500 sliding photograph for the Overview Research Gallery managed by BNHS Administrators.",
      "type": "object",
      "properties": {
        "portalId": {
          "type": "string",
          "enum": ["bnhs"],
          "maxLength": 10
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "caption": {
          "type": "string",
          "maxLength": 1000
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 750000
        },
        "displayOrder": {
          "type": "number"
        },
        "isDeleted": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["portalId", "title", "caption", "imageUrl", "displayOrder", "createdAt", "updatedAt"]
    },
    "ResearchInformationItem": {
      "title": "ResearchInformationItem",
      "description": "1000x500 institutional research video panel for the Overview section.",
      "type": "object",
      "properties": {
        "portalId": {
          "type": "string",
          "enum": ["bnhs"],
          "maxLength": 10
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "category": {
          "type": "string",
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 3000
        },
        "videoUrl": {
          "type": "string",
          "maxLength": 750000
        },
        "videoSourceType": {
          "type": "string",
          "maxLength": 30
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 750000
        },
        "linkUrl": {
          "type": "string",
          "maxLength": 500
        },
        "displayOrder": {
          "type": "number"
        },
        "isDeleted": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["portalId", "title", "category", "description", "videoUrl", "videoSourceType", "imageUrl", "linkUrl", "displayOrder", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/researches/{researchId}": {
      "schema": { "$ref": "#/entities/ResearchEntry" },
      "description": "Primary repository of Basic Research, Action Research, and TUKLAS Fair entries."
    },
    "/research_files/{fileId}": {
      "schema": { "$ref": "#/entities/ResearchFile" },
      "description": "Uploaded PDF and Word document files linked to research entries."
    },
    "/researchers/{researcherId}": {
      "schema": { "$ref": "#/entities/ResearcherProfile" },
      "description": "Public directory of BNHS teacher and student researcher profiles."
    },
    "/research_comments/{commentId}": {
      "schema": { "$ref": "#/entities/ResearchComment" },
      "description": "Comments and peer review feedback on research entries."
    },
    "/research_subscriptions/{subscriptionId}": {
      "schema": { "$ref": "#/entities/ResearchSubscription" },
      "description": "Email alert subscriptions for research status changes and new comments."
    },
    "/overview_items/{itemId}": {
      "schema": { "$ref": "#/entities/OverviewItem" },
      "description": "Customizable Overview section banners and division/highlight cards with uploaded photos."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted administrator lookup collection for RBAC enforcement."
    },
    "/status_history/{historyId}": {
      "schema": { "$ref": "#/entities/StatusHistoryEntry" },
      "description": "Audit milestones of status transitions, evaluator remarks, and dates for research entries."
    },
    "/research_gallery/{galleryId}": {
      "schema": { "$ref": "#/entities/ResearchGalleryItem" },
      "description": "Research Gallery sliding photos for the Overview page (1000x500)."
    },
    "/research_information/{infoId}": {
      "schema": { "$ref": "#/entities/ResearchInformationItem" },
      "description": "Research Information cards and guidance slides for the Overview page (1000x500)."
    }
  }
}
